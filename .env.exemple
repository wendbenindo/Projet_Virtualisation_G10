# Fichier de configuration des secrets - EXEMPLE
# Copier ce fichier en .env et remplir avec les vraies valeurs
# Ce fichier sera créé AUTOMATIQUEMENT par les scripts

# Base de données PostgreSQL (pas MySQL)
DB_HOST=192.168.X.31
DB_PORT=5432
DB_NAME=resultats_bf
DB_USER=app_user
DB_PASSWORD=changeme_app_password

# Réplication PostgreSQL
REPLICATION_USER=repl_user
REPLICATION_PASSWORD=changeme_repl_password

# Application Flask
SECRET_KEY=changeme_secret_key_for_flask
